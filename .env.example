# Provider-agnostic LLM config (OpenAI-compatible chat completions API).
# Default: Gemini free tier via Google AI Studio's OpenAI-compatible endpoint.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your_key_here

# Alternatives (same code, different URL):
# OpenCode Zen:  LLM_BASE_URL=https://opencode.ai/zen/v1        LLM_MODEL=<model id from OpenCode>
# Groq:          LLM_BASE_URL=https://api.groq.com/openai/v1    LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter:    LLM_BASE_URL=https://openrouter.ai/api/v1      LLM_MODEL=<free model id>
# Ollama local:  LLM_BASE_URL=http://localhost:11434/v1          LLM_MODEL=llama3.1   LLM_API_KEY=ollama

# --- Fallback providers -------------------------------------------------------
# Every free tier fails on its own schedule: models get withdrawn, keys hit
# capacity, regions go unwell. The client tries these in order and skips a
# provider that just failed for five minutes, so one outage is invisible.
# Suffix _2, _3, _4. Same three keys each time. All optional.
#
# Run `npm run bench:providers` to measure latency and JSON compliance against a
# realistic prompt, and order these by what it reports.
#
# LLM_BASE_URL_2=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL_2=gemini-3.6-flash
# LLM_API_KEY_2=<key>
#
# LLM_BASE_URL_3=https://openrouter.ai/api/v1
# LLM_MODEL_3=<free model id>
# LLM_API_KEY_3=<key>
#
# Cerebras is fast and OpenAI-compatible: https://api.cerebras.ai/v1 (gpt-oss-120b)
# Note: Groq's free tier caps at 8k tokens/minute, which is below this app's
# grounded prompt, so it cannot serve as a fallback until the prompt shrinks.
